PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hris_db?schema=public"
JWT_SECRET="ganti-dengan-string-acak-panjang (openssl rand -hex 48)"
JWT_EXPIRES_IN="7d"

# Skor minimal kecocokan wajah saat absen (0..1). Kalibrasi dengan foto karyawan asli.
FACE_MATCH_THRESHOLD=0.5

# Password awal akun 'admin' saat menjalankan seed (minimal 10 karakter). Segera ganti setelah login pertama.
ADMIN_INITIAL_PASSWORD=
